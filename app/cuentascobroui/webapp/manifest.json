{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sabnez.com.cuentascobroui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": { "uri": "/cuentas-cobro/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    },
    "crossNavigation": {
      "inbounds": {
        "CuentasCobro-display": {
          "semanticObject": "CuentasCobro", "action": "display",
          "title": "{{appTitle}}", "subTitle": "{{appDescription}}",
          "icon": "sap-icon://receipt",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": { "technology": "UI5", "deviceTypes": { "desktop": true, "tablet": true, "phone": true } },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": { "minUI5Version": "1.150.0", "libs": { "sap.f": {}, "sap.m": {}, "sap.ui.core": {}, "sap.ui.layout": {}, "sap.ui.unified": {} } },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "sabnez.com.cuentascobroui.i18n.i18n", "supportedLocales": [""], "fallbackLocale": "" } },
      "": { "dataSource": "mainService", "preload": true, "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true, "groupId": "$direct", "updateGroupId": "$direct" } }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "routing": {
      "config": { "routerClass": "sap.m.routing.Router", "controlAggregation": "pages", "controlId": "app", "transition": "slide", "type": "View", "viewType": "XML", "path": "sabnez.com.cuentascobroui.view", "async": true },
      "routes": [{ "name": "main", "pattern": ":?query:", "target": "main" }],
      "targets": { "main": { "id": "Main", "name": "Main" } }
    },
    "rootView": { "viewName": "sabnez.com.cuentascobroui.view.App", "type": "XML", "id": "App", "async": true }
  },
  "sap.cloud": { "public": true, "service": "sabnezrrhh.service" }
}
