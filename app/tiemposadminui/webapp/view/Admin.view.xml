<mvc:View controllerName="sabnez.com.tiemposadminui.controller.Admin" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:fdp="sap.f" xmlns:u="sap.ui.unified">
  <fdp:DynamicPage id="commercialAdminPage" class="commercialAdminDynamicPage" busy="{view>/busy}" busyIndicatorDelay="0" fitContent="true" preserveHeaderStateOnScroll="true" toggleHeaderOnTitleClick="true">
    <fdp:title>
      <fdp:DynamicPageTitle>
        <fdp:heading><Title text="Configuración comercial" level="H1"/></fdp:heading>
        <fdp:expandedContent><Text text="Clientes, contratos, proyectos, asignaciones y tarifas"/></fdp:expandedContent>
        <fdp:snappedContent><Text text="Administración comercial"/></fdp:snappedContent>
        <fdp:actions><Button icon="sap-icon://refresh" tooltip="Actualizar" press=".onRefresh"/></fdp:actions>
      </fdp:DynamicPageTitle>
    </fdp:title>
    <fdp:header>
      <fdp:DynamicPageHeader pinnable="true">
        <fdp:content>
          <FlexBox wrap="Wrap" alignItems="Stretch" class="commercialSummaryStrip">
            <VBox class="commercialSummaryCard commercialSummaryPrimary"><Label text="Clientes"/><ObjectNumber number="{view>/clients/length}" unit="registros"/><Text text="Relaciones comerciales"/></VBox>
            <VBox class="commercialSummaryCard commercialSummaryInfo"><Label text="Contratos"/><ObjectNumber number="{view>/contracts/length}" unit="registros"/><Text text="Acuerdos y documentos"/></VBox>
            <VBox class="commercialSummaryCard commercialSummaryInfo"><Label text="Proyectos"/><ObjectNumber number="{view>/projects/length}" unit="registros"/><Text text="Servicios configurados"/></VBox>
            <VBox class="commercialSummaryCard commercialSummaryInfo"><Label text="Asignaciones"/><ObjectNumber number="{view>/assignments/length}" unit="registros"/><Text text="Empleados en proyectos"/></VBox>
            <VBox class="commercialSummaryCard commercialSummaryInfo"><Label text="Aprobadores"/><ObjectNumber number="{view>/approvers/length}" unit="registros"/><Text text="Responsables de revisión"/></VBox>
            <VBox class="commercialSummaryCard commercialSummarySuccess" visible="{view>/canSeeRates}"><Label text="Tarifas"/><ObjectNumber number="{view>/rates/length}" unit="registros"/><Text text="Condiciones económicas"/></VBox>
          </FlexBox>
        </fdp:content>
      </fdp:DynamicPageHeader>
    </fdp:header>
    <fdp:content>
      <VBox class="sapUiResponsiveContentPadding commercialAdminContent">
      <MessageStrip text="{view>/error}" type="Error" showIcon="true" showCloseButton="true" visible="{= !!${view>/error} }" close=".onDismissError" class="sapUiSmallMarginBottom"/>
      <IconTabBar id="tabs" expandable="false" applyContentPadding="false" class="commercialTabs">
        <items>
          <IconTabFilter key="clients" text="Clientes" icon="sap-icon://customer" count="{view>/clients/length}">
            <VBox class="adminSection"><Title text="{= ${view>/clientForm/ID} ? 'Editar cliente' : 'Nuevo cliente' }" level="H3" class="adminSectionTitle"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Razón social" required="true"/><Input value="{view>/clientForm/legalName}"/><Label text="Nombre comercial"/><Input value="{view>/clientForm/tradeName}"/><Label text="Identificación tributaria" required="true"/><Input value="{view>/clientForm/taxIdentification}"/><Label text="País"/><Select selectedKey="{view>/clientForm/countryCode}" class="compactReferenceSelect"><core:Item key="CO" text="Colombia"/><core:Item key="US" text="Estados Unidos"/><core:Item key="MX" text="México"/><core:Item key="PE" text="Perú"/><core:Item key="CL" text="Chile"/><core:Item key="EC" text="Ecuador"/><core:Item key="PA" text="Panamá"/><core:Item key="CR" text="Costa Rica"/><core:Item key="ES" text="España"/></Select><Label text="Moneda"/><Select selectedKey="{view>/clientForm/defaultCurrency}" class="compactReferenceSelect"><core:Item key="COP" text="COP · Peso colombiano"/><core:Item key="USD" text="USD · Dólar estadounidense"/><core:Item key="EUR" text="EUR · Euro"/><core:Item key="MXN" text="MXN · Peso mexicano"/><core:Item key="PEN" text="PEN · Sol peruano"/><core:Item key="CLP" text="CLP · Peso chileno"/></Select><Label text="Zona horaria"/><Select selectedKey="{view>/clientForm/timeZone}" class="compactReferenceSelect"><core:Item key="America/Bogota" text="Bogotá (UTC-5)"/><core:Item key="America/Lima" text="Lima (UTC-5)"/><core:Item key="America/Guayaquil" text="Quito (UTC-5)"/><core:Item key="America/Panama" text="Panamá (UTC-5)"/><core:Item key="America/Mexico_City" text="Ciudad de México"/><core:Item key="America/Santiago" text="Santiago"/><core:Item key="America/New_York" text="Nueva York"/><core:Item key="America/Chicago" text="Chicago"/><core:Item key="America/Denver" text="Denver"/><core:Item key="America/Los_Angeles" text="Los Ángeles"/><core:Item key="Europe/Madrid" text="Madrid"/></Select><Label text="Exento de impuestos"/><Switch state="{view>/clientForm/taxExempt}"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/clientForm/ID} }" press=".onCancelClientEdit"/><ToolbarSpacer/><Button text="{= ${view>/clientForm/ID} ? 'Actualizar cliente' : 'Guardar cliente' }" type="Emphasized" icon="sap-icon://save" press=".onSaveClient"/></Toolbar>
            <Table items="{view>/clients}" noDataText="No hay clientes registrados" growing="true"><columns><Column><Text text="Cliente"/></Column><Column><Text text="Identificación"/></Column><Column><Text text="Moneda"/></Column><Column><Text text="Estado"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>tradeName}" text="{view>legalName}"/><Text text="{view>taxIdentification}"/><Text text="{view>defaultCurrency}"/><ObjectStatus text="{view>status}" state="Success"/><HBox justifyContent="End"><Button icon="sap-icon://edit" tooltip="Editar" type="Transparent" press=".onEditClient"/><Button icon="sap-icon://delete" tooltip="Eliminar" type="Transparent" press=".onDeleteClient"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>

          <IconTabFilter key="contracts" text="Contratos" icon="sap-icon://document-text" count="{view>/contracts/length}">
            <VBox class="adminSection"><Title text="{= ${view>/contractForm/ID} ? 'Editar contrato' : 'Nuevo contrato' }" level="H3" class="adminSectionTitle"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Cliente" required="true"/><Select selectedKey="{view>/contractForm/clientID}" items="{view>/clients}"><core:Item key="{view>ID}" text="{view>tradeName}"/></Select><Label text="Referencia" required="true"/><Input value="{view>/contractForm/reference}"/><Label text="Descripción"/><Input value="{view>/contractForm/description}"/><Label text="Inicio" required="true"/><DatePicker value="{view>/contractForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Fin"/><DatePicker value="{view>/contractForm/validTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Moneda"/><Select selectedKey="{view>/contractForm/currency}"><core:Item key="COP" text="COP · Peso colombiano"/><core:Item key="USD" text="USD · Dólar estadounidense"/><core:Item key="EUR" text="EUR · Euro"/><core:Item key="MXN" text="MXN · Peso mexicano"/><core:Item key="PEN" text="PEN · Sol peruano"/><core:Item key="CLP" text="CLP · Peso chileno"/></Select><Label text="Valor total"/><Input value="{view>/contractForm/totalValue}" type="Number"/><Label text="Aviso renovación (días)"/><StepInput value="{view>/contractForm/renewalNoticeDays}" min="0" step="1"/><Label text="Documento firmado"/><u:FileUploader id="contractUploader" change=".onContractFileSelected" sameFilenameAllowed="true" buttonText="Seleccionar" placeholder="PDF o documento · máximo 10 MB"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/contractForm/ID} }" press=".onCancelContractEdit"/><ToolbarSpacer/><Button text="{= ${view>/contractForm/ID} ? 'Actualizar contrato' : 'Guardar contrato' }" type="Emphasized" icon="sap-icon://save" press=".onSaveContract"/></Toolbar>
            <Table items="{view>/contracts}" noDataText="No hay contratos" growing="true"><columns><Column><Text text="Contrato"/></Column><Column><Text text="Cliente"/></Column><Column><Text text="Vigencia"/></Column><Column><Text text="Documento"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>reference}" text="{view>description}"/><Text text="{view>clientName}"/><Text text="{= ${view>validFrom} + ' — ' + (${view>validTo} || 'Vigente') }"/><Button text="{= ${view>documentCount} + ' archivo(s)' }" icon="sap-icon://attachment" type="Transparent" press=".onDownloadContract" enabled="{= ${view>documentCount} > 0 }"/><HBox justifyContent="End"><Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditContract"/><Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press=".onDeleteContract"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>

          <IconTabFilter key="projects" text="Proyectos" icon="sap-icon://project-definition-triangle-2" count="{view>/projects/length}">
            <VBox class="adminSection"><Title text="{= ${view>/projectForm/ID} ? 'Editar proyecto' : 'Nuevo proyecto' }" level="H3" class="adminSectionTitle"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Cliente" required="true"/><Select selectedKey="{view>/projectForm/clientID}" items="{view>/clients}" change=".onProjectClientChange"><core:Item key="{view>ID}" text="{view>tradeName}"/></Select><Label text="Contrato asociado"/><Select selectedKey="{view>/projectForm/contractID}" items="{view>/contractsForProject}" forceSelection="false"><core:Item key="{view>ID}" text="{view>reference}"/></Select><Label text="Código" required="true"/><Input value="{view>/projectForm/code}"/><Label text="Nombre" required="true"/><Input value="{view>/projectForm/name}"/><Label text="Descripción"/><Input value="{view>/projectForm/description}"/><Label text="Inicio" required="true"/><DatePicker value="{view>/projectForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Fin"/><DatePicker value="{view>/projectForm/validTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Modalidad"/><Select selectedKey="{view>/projectForm/modality}"><core:Item key="FULL_TIME" text="Full time"/><core:Item key="HOURLY" text="Por horas"/><core:Item key="MIXED" text="Mixto"/><core:Item key="INTERNAL" text="Interno"/></Select><Label text="Descripción obligatoria"/><Switch state="{view>/projectForm/requiresDescription}"/><Label text="Soporte obligatorio"/><Switch state="{view>/projectForm/requiresEvidence}"/><Label text="Aprobación del cliente"/><Switch state="{view>/projectForm/requiresClientApproval}"/><Label text="Esquema de aprobación"/><Select selectedKey="{view>/projectForm/approvalScheme}"><core:Item key="LEADER_THEN_ADMIN" text="Líder y luego administración"/><core:Item key="LEADER_ONLY" text="Solo líder"/><core:Item key="ADMIN_ONLY" text="Solo administración"/><core:Item key="LEADER_OR_ADMIN" text="Líder o administración"/></Select><Label text="Alerta diaria desde"/><StepInput value="{view>/projectForm/dailyWarningHours}" min="1" max="24" step="0.5" displayValuePrecision="1"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/projectForm/ID} }" press=".onCancelProjectEdit"/><ToolbarSpacer/><Button text="{= ${view>/projectForm/ID} ? 'Actualizar proyecto' : 'Guardar proyecto' }" type="Emphasized" icon="sap-icon://save" press=".onSaveProject"/></Toolbar>
            <Table items="{view>/projects}" noDataText="No hay proyectos" growing="true"><columns><Column><Text text="Proyecto"/></Column><Column><Text text="Cliente / contrato"/></Column><Column><Text text="Modalidad"/></Column><Column><Text text="Vigencia"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>name}" text="{view>code}"/><ObjectIdentifier title="{view>clientName}" text="{view>contractReference}"/><ObjectStatus text="{view>modality}" state="Information"/><Text text="{= ${view>validFrom} + ' — ' + (${view>validTo} || 'Sin fecha fin') }"/><HBox justifyContent="End"><Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditProject"/><Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press=".onDeleteProject"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>

          <IconTabFilter key="assignments" text="Asignaciones" icon="sap-icon://employee" count="{view>/assignments/length}">
            <VBox class="adminSection"><Title text="{= ${view>/assignmentForm/ID} ? 'Editar asignación' : 'Nueva asignación' }" level="H3" class="adminSectionTitle"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Proyecto" required="true"/><Select selectedKey="{view>/assignmentForm/projectID}" items="{view>/projects}"><core:Item key="{view>ID}" text="{view>name}"/></Select><Label text="Empleado" required="true"/><Select selectedKey="{view>/assignmentForm/employeeID}" items="{view>/employees}"><core:Item key="{view>ID}" text="{view>nombreCompleto}"/></Select><Label text="Rol"/><Input value="{view>/assignmentForm/role}"/><Label text="Inicio" required="true"/><DatePicker value="{view>/assignmentForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Fin"/><DatePicker value="{view>/assignmentForm/validTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Asignación comercial (%)"/><StepInput value="{view>/assignmentForm/commercialAllocation}" min="0" max="100" step="5"/><Label text="Principal"/><Switch state="{view>/assignmentForm/isPrimary}"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/assignmentForm/ID} }" press=".onCancelAssignmentEdit"/><ToolbarSpacer/><Button text="{= ${view>/assignmentForm/ID} ? 'Actualizar asignación' : 'Guardar asignación' }" type="Emphasized" icon="sap-icon://save" press=".onSaveAssignment"/></Toolbar>
            <Table items="{view>/assignments}" noDataText="No hay asignaciones" growing="true"><columns><Column><Text text="Empleado"/></Column><Column><Text text="Proyecto"/></Column><Column><Text text="Rol"/></Column><Column><Text text="Vigencia"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><Text text="{view>employeeName}"/><Text text="{view>projectName}"/><Text text="{view>role}"/><Text text="{= ${view>validFrom} + ' — ' + (${view>validTo} || 'Vigente') }"/><HBox justifyContent="End"><Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditAssignment"/><Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press=".onDeleteAssignment"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>

          <IconTabFilter key="approvers" text="Aprobadores" icon="sap-icon://approvals" count="{view>/approvers/length}">
            <VBox class="adminSection"><Title text="{= ${view>/approverForm/ID} ? 'Editar aprobador' : 'Nuevo aprobador' }" level="H3" class="adminSectionTitle"/><MessageStrip text="Los aprobadores reciben por correo las hojas enviadas de los proyectos asignados." type="Information" showIcon="true"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Proyecto" required="true"/><Select selectedKey="{view>/approverForm/projectID}" items="{view>/projects}"><core:Item key="{view>ID}" text="{view>name}"/></Select><Label text="Responsable" required="true"/><Select selectedKey="{view>/approverForm/employeeID}" items="{view>/employees}"><core:Item key="{view>ID}" text="{view>nombreCompleto}"/></Select><Label text="Tipo"/><Select selectedKey="{view>/approverForm/approverType}"><core:Item key="LEADER" text="Líder de proyecto"/><core:Item key="BACKUP" text="Aprobador suplente"/></Select><Label text="Inicio" required="true"/><DatePicker value="{view>/approverForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Fin"/><DatePicker value="{view>/approverForm/validTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Activo"/><Switch state="{view>/approverForm/active}"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/approverForm/ID} }" press=".onCancelApproverEdit"/><ToolbarSpacer/><Button text="{= ${view>/approverForm/ID} ? 'Actualizar aprobador' : 'Guardar aprobador' }" type="Emphasized" icon="sap-icon://save" press=".onSaveApprover"/></Toolbar>
            <Table items="{view>/approvers}" noDataText="No hay aprobadores configurados" growing="true"><columns><Column><Text text="Responsable"/></Column><Column><Text text="Proyecto"/></Column><Column><Text text="Tipo"/></Column><Column><Text text="Vigencia"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>employeeName}" text="{view>employeeEmail}"/><Text text="{view>projectName}"/><ObjectStatus text="{view>approverType}" state="Information"/><Text text="{= ${view>validFrom} + ' — ' + (${view>validTo} || 'Vigente') }"/><HBox justifyContent="End"><Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditApprover"/><Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press=".onDeleteApprover"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>

          <IconTabFilter key="rates" text="Tarifas" icon="sap-icon://money-bills" count="{view>/rates/length}" visible="{view>/canSeeRates}">
            <VBox class="adminSection"><Title text="{= ${view>/rateForm/ID} ? 'Editar tarifa' : 'Nueva tarifa' }" level="H3" class="adminSectionTitle"/><MessageStrip text="Las tarifas y costos internos solo son visibles para usuarios financieros." type="Information" showIcon="true"/><f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsXL="3" columnsL="3" columnsM="2" class="commercialForm">
              <Label text="Asignación" required="true"/><Select selectedKey="{view>/rateForm/assignmentID}" items="{view>/assignments}"><core:Item key="{view>ID}" text="{= ${view>employeeName} + ' · ' + ${view>projectName} }"/></Select><Label text="Inicio" required="true"/><DatePicker value="{view>/rateForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Fin"/><DatePicker value="{view>/rateForm/validTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/><Label text="Moneda"/><Select selectedKey="{view>/rateForm/currency}"><core:Item key="COP" text="COP · Peso colombiano"/><core:Item key="USD" text="USD · Dólar estadounidense"/><core:Item key="EUR" text="EUR · Euro"/><core:Item key="MXN" text="MXN · Peso mexicano"/><core:Item key="PEN" text="PEN · Sol peruano"/><core:Item key="CLP" text="CLP · Peso chileno"/></Select><Label text="Venta mensual"/><Input value="{view>/rateForm/monthlySaleRate}" type="Number"/><Label text="Venta hora regular"/><Input value="{view>/rateForm/regularSaleHourlyRate}" type="Number"/><Label text="Venta hora extra"/><Input value="{view>/rateForm/overtimeSaleHourlyRate}" type="Number"/><Label text="Costo interno mensual"/><Input value="{view>/rateForm/internalMonthlyCost}" type="Number"/><Label text="Costo interno por hora"/><Input value="{view>/rateForm/internalHourlyCost}" type="Number"/>
            </f:SimpleForm><Toolbar><Button text="Cancelar edición" visible="{= !!${view>/rateForm/ID} }" press=".onCancelRateEdit"/><ToolbarSpacer/><Button text="{= ${view>/rateForm/ID} ? 'Actualizar tarifa' : 'Guardar tarifa' }" type="Emphasized" icon="sap-icon://save" press=".onSaveRate"/></Toolbar>
            <Table items="{view>/rates}" noDataText="No hay tarifas" growing="true"><columns><Column><Text text="Empleado / proyecto"/></Column><Column><Text text="Vigencia"/></Column><Column hAlign="End"><Text text="Venta mensual"/></Column><Column hAlign="End"><Text text="Hora regular"/></Column><Column hAlign="End"><Text text="Hora extra"/></Column><Column hAlign="End"><Text text="Acciones"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>employeeName}" text="{view>projectName}"/><Text text="{= ${view>validFrom} + ' — ' + (${view>validTo} || 'Vigente') }"/><ObjectNumber number="{view>monthlySaleRate}" unit="{view>currency}"/><ObjectNumber number="{view>regularSaleHourlyRate}" unit="{view>currency}"/><ObjectNumber number="{view>overtimeSaleHourlyRate}" unit="{view>currency}"/><HBox justifyContent="End"><Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditRate"/><Button icon="sap-icon://delete" type="Transparent" tooltip="Eliminar" press=".onDeleteRate"/></HBox></cells></ColumnListItem></items></Table></VBox>
          </IconTabFilter>
        </items>
      </IconTabBar>
      </VBox>
    </fdp:content>
  </fdp:DynamicPage>
</mvc:View>
