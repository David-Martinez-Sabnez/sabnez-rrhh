{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sabnez.com.tiemposadminui",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "tiempos-admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TiemposAdmin-display": {
          "semanticObject": "TiemposAdmin",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubtitle}}",
          "icon": "sap-icon://blur",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sabnez.com.tiemposadminui.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "rootView": {
      "viewName": "sabnez.com.tiemposadminui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "controlAggregation": "beginColumnPages",
        "controlId": "fcl",
        "type": "View",
        "viewType": "XML",
        "path": "sabnez.com.tiemposadminui.view",
        "async": true,
        "transition": "slide"
      },
      "routes": [
        {
          "name": "projects",
          "pattern": "",
          "target": [
            "projectList"
          ],
          "layout": "OneColumn"
        },
        {
          "name": "projectDetail",
          "pattern": "proyectos/{projectId}",
          "target": [
            "projectList",
            "projectDetail"
          ],
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "clients",
          "pattern": "clientes",
          "target": [
            "clientList"
          ],
          "layout": "OneColumn"
        },
        {
          "name": "clientDetail",
          "pattern": "clientes/{clientId}",
          "target": [
            "clientList",
            "clientDetail"
          ],
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "name": "rates",
          "pattern": "tarifas",
          "target": [
            "rateList"
          ],
          "layout": "OneColumn"
        }
      ],
      "targets": {
        "projectList": {
          "id": "projectList",
          "name": "ProjectList",
          "controlAggregation": "beginColumnPages"
        },
        "projectDetail": {
          "id": "projectDetail",
          "name": "ProjectDetail",
          "controlAggregation": "midColumnPages"
        },
        "clientList": {
          "id": "clientList",
          "name": "ClientList",
          "controlAggregation": "beginColumnPages"
        },
        "clientDetail": {
          "id": "clientDetail",
          "name": "ClientDetail",
          "controlAggregation": "midColumnPages"
        },
        "rateList": {
          "id": "rateList",
          "name": "RateList",
          "controlAggregation": "beginColumnPages"
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "sabnezrrhh.service"
  }
}
