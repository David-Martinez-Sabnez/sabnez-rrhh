<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog title="{= ${view>/approverForm/ID} ? 'Editar aprobador' : 'Añadir aprobador' }"
    contentWidth="30rem" resizable="true" draggable="true" class="formDialog">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" columnsL="1" columnsM="1"
        labelSpanL="4" labelSpanM="4" adjustLabelSpan="false" class="dialogForm">
        <Label text="Responsable" required="true"/>
        <ComboBox selectedKey="{view>/approverForm/employeeID}" items="{view>/employees}"
          placeholder="Elige al responsable">
          <core:Item key="{view>ID}" text="{view>nombreCompleto}"/>
        </ComboBox>

        <Label text="Tipo"/>
        <Select selectedKey="{view>/approverForm/approverType}">
          <core:Item key="ADMIN" text="Administrativo · segunda aprobación"/>
          <core:Item key="LEADER" text="Líder de proyecto · primera revisión"/>
          <core:Item key="BACKUP" text="Suplente"/>
        </Select>

        <Label text="Inicio" required="true"/>
        <DatePicker value="{view>/approverForm/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/>

      </f:SimpleForm>
      <MessageStrip class="dialogHint" showIcon="true" type="Information"
        text="Debe ser un empleado activo y con correo corporativo. Si una semana toca varios proyectos, la misma persona tiene que estar configurada en todos."/>
    </content>
    <beginButton><Button text="Cancelar" press=".onApproverCancel"/></beginButton>
    <endButton>
      <Button text="{= ${view>/approverForm/ID} ? 'Guardar cambios' : 'Añadir' }"
        type="Emphasized" press=".onApproverSave"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
