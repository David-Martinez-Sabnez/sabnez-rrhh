<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <VBox class="sapUxAPObjectPageSubSectionAlignContent sabnezBalancesRoot">

        <VBox class="sabnezBalanceBlock">
            <HBox
                alignItems="Center"
                justifyContent="SpaceBetween"
                wrap="Wrap"
                class="sabnezBalanceHeader">
                <VBox>
                    <Title text="{i18n>vacationBalanceTitle}" level="H3" />
                    <Text
                        text="{i18n>vacationBalanceSubtitle}"
                        class="sabnezBalanceSubtitle" />
                </VBox>
                <ObjectStatus
                    text="{i18n>daysUnitPlural}"
                    icon="sap-icon://calendar" />
            </HBox>

            <FlexBox
                wrap="Wrap"
                alignItems="Stretch"
                renderType="Div"
                class="sabnezKpiGrid">

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>vacationAccruedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{diasVacacionesCausados}"
                        unit="{i18n>daysUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>vacationUsedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{diasVacacionesDisfrutados}"
                        unit="{i18n>daysUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>vacationReservedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{diasVacacionesReservados}"
                        unit="{i18n>daysUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard sabnezKpiCardAvailable">
                    <Text
                        text="{i18n>vacationAvailableLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{diasVacacionesDisponibles}"
                        unit="{i18n>daysUnit}"
                        state="Success"
                        emphasized="true" />
                </VBox>
            </FlexBox>
        </VBox>

        <VBox class="sabnezBalanceBlock sabnezBalanceBlockSpacing">
            <HBox
                alignItems="Center"
                justifyContent="SpaceBetween"
                wrap="Wrap"
                class="sabnezBalanceHeader">
                <VBox>
                    <Title text="{i18n>emotionalVoucherTitle}" level="H3" />
                    <Text
                        text="{i18n>emotionalVoucherSubtitle}"
                        class="sabnezBalanceSubtitle" />
                </VBox>
                <ObjectStatus
                    text="{i18n>annualBenefitLabel}"
                    icon="sap-icon://time-account" />
            </HBox>

            <FlexBox
                wrap="Wrap"
                alignItems="Stretch"
                renderType="Div"
                class="sabnezKpiGrid">

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>voucherAssignedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{horasValeraAsignadas}"
                        unit="{i18n>hoursUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>voucherUsedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{horasValeraUtilizadas}"
                        unit="{i18n>hoursUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard">
                    <Text
                        text="{i18n>voucherReservedLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{horasValeraReservadas}"
                        unit="{i18n>hoursUnit}"
                        emphasized="true" />
                </VBox>

                <VBox class="sabnezKpiCard sabnezKpiCardAvailable">
                    <Text
                        text="{i18n>voucherAvailableLabel}"
                        class="sabnezKpiLabel" />
                    <ObjectNumber
                        number="{horasValeraDisponibles}"
                        unit="{i18n>hoursUnit}"
                        state="Success"
                        emphasized="true" />
                </VBox>
            </FlexBox>

            <FlexBox
                wrap="Wrap"
                alignItems="Center"
                renderType="Div"
                class="sabnezBenefitMeta">

                <HBox alignItems="Center" class="sabnezBenefitMetaItem">
                    <core:Icon src="sap-icon://calendar" class="sabnezBenefitMetaIcon" />
                    <VBox>
                        <Label text="{i18n>benefitYearLabel}" />
                        <Text
                            text="{path: 'valeraAnioActual', type: 'sap.ui.model.odata.type.Int32', formatOptions: {groupingEnabled: false}}" />
                    </VBox>
                </HBox>

                <HBox alignItems="Center" class="sabnezBenefitMetaItem">
                    <core:Icon src="sap-icon://date-time" class="sabnezBenefitMetaIcon" />
                    <VBox>
                        <Label text="{i18n>expirationLabel}" />
                        <Text text="{vencimientoValera}" />
                    </VBox>
                </HBox>

                <HBox alignItems="Center" class="sabnezBenefitMetaItem">
                    <core:Icon src="sap-icon://synchronize" class="sabnezBenefitMetaIcon" />
                    <VBox>
                        <Label text="{i18n>nextReloadLabel}" />
                        <Text text="{proximaRecargaValera}" />
                    </VBox>
                </HBox>
            </FlexBox>
        </VBox>

    </VBox>
</core:FragmentDefinition>
