{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sabnez.com.aprobacionesui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "aprobaciones/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Aprobaciones-display": {
          "semanticObject": "Aprobaciones",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubtitle}}",
          "icon": "sap-icon://approvals",
          "signature": {
            "parameters": {
              "taskId": {
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sabnez.com.aprobacionesui.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sabnez.com.aprobacionesui.view",
        "async": true
      },
      "routes": [
        {
          "name": "Approvals",
          "pattern": ":?query:",
          "target": "Approvals"
        },
        {
          "name": "TaskDetail",
          "pattern": "task/{id}:?query:",
          "target": "Approvals"
        }
      ],
      "targets": {
        "Approvals": {
          "id": "Approvals",
          "name": "Approvals"
        }
      }
    },
    "rootView": {
      "viewName": "sabnez.com.aprobacionesui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "sabnezrrhh.service"
  }
}
