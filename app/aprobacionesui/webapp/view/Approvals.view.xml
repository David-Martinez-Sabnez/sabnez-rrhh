<mvc:View
  id="approvalsView"
  controllerName="sabnez.com.aprobacionesui.controller.Approvals"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <f:DynamicPage
    id="approvalsPage"
    busy="{view>/busy}"
    busyIndicatorDelay="0"
    fitContent="true"
    preserveHeaderStateOnScroll="true"
    toggleHeaderOnTitleClick="true"
    stateChange=".onHeaderStateChange">

    <f:title>
        <f:DynamicPageTitle id="pageTitle">
          <f:heading>
            <Title id="title" text="{i18n>appTitle}" level="H1" />
        </f:heading>
        <f:expandedContent>
          <Text id="pageSubtitle" text="{i18n>pageSubtitle}" />
        </f:expandedContent>
        <f:snappedContent>
          <Text id="snappedSummary" text="{view>/snappedSummary}" />
        </f:snappedContent>
        <f:actions>
          <Button
            id="refreshButton"
            icon="sap-icon://refresh"
            tooltip="{i18n>refresh}"
            enabled="{= !${view>/busy} &amp;&amp; !${view>/actionBusy} }"
            press=".onRefresh" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader id="summaryHeader" pinnable="true">
        <f:content>
          <VBox id="summaryContent" width="100%">
            <MessageStrip
              id="loadErrorStrip"
              text="{view>/error}"
              type="Error"
              showIcon="true"
              showCloseButton="true"
              close=".onDismissError"
              visible="{= !!${view>/error} }"
              class="sapUiSmallMarginBottom" />

            <FlexBox
              id="kpiContainer"
              wrap="Wrap"
              alignItems="Stretch"
              class="approvalKpiContainer">
              <VBox id="pendingCard" class="approvalKpiCard approvalKpiPrimary">
                <HBox id="pendingCardHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="pendingCardIcon" src="sap-icon://pending" decorative="true" />
                  <Label id="pendingCardLabel" text="{i18n>pendingDecisions}" />
                </HBox>
                <ObjectNumber
                  id="pendingCardNumber"
                  number="{view>/summary/porDecidir}"
                  unit="{i18n>tasksUnit}"
                  state="Warning" />
                <Text id="pendingCardDetail" text="{i18n>pendingCardDetail}" />
              </VBox>

              <VBox id="dueSoonCard" class="approvalKpiCard approvalKpiCritical">
                <HBox id="dueSoonCardHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="dueSoonCardIcon" src="sap-icon://lateness" decorative="true" />
                  <Label id="dueSoonCardLabel" text="{i18n>dueSoon}" />
                </HBox>
                <ObjectNumber
                  id="dueSoonCardNumber"
                  number="{view>/summary/vencidas}"
                  unit="{i18n>tasksUnit}"
                  state="Error" />
                <Text id="dueSoonCardDetail" text="{i18n>dueSoonDetail}" />
              </VBox>

              <VBox id="backupCard" class="approvalKpiCard approvalKpiInformation">
                <HBox id="backupCardHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="backupCardIcon" src="sap-icon://group" decorative="true" />
                  <Label id="backupCardLabel" text="{i18n>asBackup}" />
                </HBox>
                <ObjectNumber
                  id="backupCardNumber"
                  number="{view>/summary/comoBackup}"
                  unit="{i18n>tasksUnit}"
                  state="Information" />
                <Text id="backupCardDetail" text="{i18n>backupCardDetail}" />
              </VBox>

              <VBox id="delegatedCard" class="approvalKpiCard approvalKpiDelegated">
                <HBox id="delegatedCardHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="delegatedCardIcon" src="sap-icon://share-2" decorative="true" />
                  <Label id="delegatedCardLabel" text="{i18n>delegatedByMe}" />
                </HBox>
                <ObjectNumber
                  id="delegatedCardNumber"
                  number="{view>/summary/delegadasPorMi}"
                  unit="{i18n>delegationsUnit}"
                  state="Information" />
                <Text id="delegatedCardDetail" text="{i18n>delegatedCardDetail}" />
              </VBox>

              <VBox id="approvedCard" class="approvalKpiCard approvalKpiSuccess">
                <HBox id="approvedHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="approvedIcon" src="sap-icon://accept" decorative="true" />
                  <Label id="approvedLabel" text="{i18n>approvedDecisions}" />
                </HBox>
                <ObjectNumber
                  id="approvedNumber"
                  number="{view>/summary/aprobadas}"
                  unit="{i18n>tasksUnit}"
                  state="Success" />
                <Text id="approvedDetail" text="{i18n>approvedCardDetail}" />
              </VBox>

              <VBox id="rejectedCard" class="approvalKpiCard approvalKpiRejected">
                <HBox id="rejectedHeader" alignItems="Center" class="approvalKpiHeader">
                  <core:Icon id="rejectedIcon" src="sap-icon://decline" decorative="true" />
                  <Label id="rejectedLabel" text="{i18n>rejectedDecisions}" />
                </HBox>
                <ObjectNumber
                  id="rejectedNumber"
                  number="{view>/summary/rechazadas}"
                  unit="{i18n>tasksUnit}"
                  state="Error" />
                <Text id="rejectedDetail" text="{i18n>rejectedCardDetail}" />
              </VBox>
            </FlexBox>
          </VBox>
        </f:content>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <VBox id="pageContent" class="approvalPageContent sapUiResponsiveContentPadding">
        <IconTabBar
          id="workTabs"
          selectedKey="{view>/selectedTab}"
          expandable="false"
          stretchContentHeight="false"
          select=".onTabSelect"
          class="approvalWorkTabs">
          <items>
            <IconTabFilter
              id="pendingTab"
              key="PENDING"
              text="{i18n>pendingTab}"
              icon="sap-icon://inbox"
              count="{view>/tabCounts/pending}" />
            <IconTabFilter
              id="backupTab"
              key="BACKUP"
              text="{i18n>backupTab}"
              icon="sap-icon://collaborate"
              count="{view>/tabCounts/backup}" />
            <IconTabFilter
              id="historyTab"
              key="HISTORY"
              text="{i18n>historyTab}"
              icon="sap-icon://history"
              count="{view>/tabCounts/history}" />
          </items>
          <content>
            <VBox id="worklistContent" width="100%">
              <FlexBox id="filterToolbar" wrap="Wrap" alignItems="Center" class="approvalFilterToolbar approvalFilterBar">
                <SearchField
                  id="taskSearch"
                  width="19rem"
                  placeholder="{i18n>searchPlaceholder}"
                  liveChange=".onSearch" />
                <Select
                  id="typeFilter"
                  width="13rem"
                  selectedKey="{view>/filters/type}"
                  change=".onFilterChange"
                  tooltip="{i18n>processType}"
                  items="{view>/typeFilters}">
                  <core:Item id="typeFilterItem" key="{view>key}" text="{view>text}" />
                </Select>
                <Select
                  id="statusFilter"
                  width="11rem"
                  selectedKey="{view>/filters/status}"
                  change=".onFilterChange"
                  tooltip="{i18n>status}"
                  visible="{= ${view>/selectedTab} === 'HISTORY' }"
                  items="{view>/statusFilters}">
                  <core:Item id="statusFilterItem" key="{view>key}" text="{view>text}" />
                </Select>
                <DateRangeSelection
                  id="dateFilter"
                  width="15rem"
                  delimiter="–"
                  displayFormat="medium"
                  placeholder="{i18n>dateRangePlaceholder}"
                  change=".onDateFilterChange" />
                <Button
                  id="clearFiltersButton"
                  icon="sap-icon://clear-filter"
                  tooltip="{i18n>clearFilters}"
                  type="Transparent"
                  press=".onClearFilters" />
              </FlexBox>

              <SplitApp
                id="approvalWorkSplit"
                initialMaster="approvalInboxPage"
                initialDetail="approvalEmptyPage"
                mode="ShowHideMode"
                class="approvalInboxSplit">
                <masterPages>
                  <Page id="approvalInboxPage" title="{view>/worklistTitle}" busy="{view>/actionBusy}">
                    <headerContent>
                      <ObjectStatus text="{view>/resultCountLabel}" state="Information" />
                    </headerContent>
                    <content>
                      <List
                        id="tasksList"
                        items="{view>/filteredTasks}"
                        growing="true"
                        growingScrollToLoad="true"
                        growingThreshold="20"
                        showSeparators="Inner"
                        noDataText="{view>/noDataTitle}"
                        itemPress=".onOpenTask">
                        <ObjectListItem
                          id="taskItem"
                          type="Active"
                          title="{view>employeeName}"
                          intro="{view>requestTitle}"
                          >
                          <attributes>
                            <ObjectAttribute text="{view>requestSummary}" />
                            <ObjectAttribute text="{view>processCode}" />
                            <ObjectAttribute text="{view>submittedText}" />
                          </attributes>
                          <firstStatus>
                            <ObjectStatus text="{view>statusText}" state="{view>statusState}" icon="{view>statusIcon}" />
                          </firstStatus>
                          <secondStatus>
                            <ObjectStatus text="{view>roleText}" state="{view>roleState}" visible="{= !!${view>roleText} }" />
                          </secondStatus>
                        </ObjectListItem>
                      </List>
                    </content>
                  </Page>
                </masterPages>
                <detailPages>
                  <Page id="approvalEmptyPage" title="{i18n>taskDetail}">
                    <content>
                      <IllustratedMessage
                        illustrationType="sapIllus-NoTasks"
                        title="{i18n>selectApproval}"
                        description="{i18n>selectApprovalDescription}" />
                    </content>
                  </Page>
                  <Page
                    id="inlineTaskDetailPage"
                    title="{i18n>taskDetail}"
                    showNavButton="true"
                    navButtonPress=".onCloseTaskDetail"
                    busy="{view>/actionBusy}"
                    class="approvalInlineDetailPage">
                    <subHeader>
                      <OverflowToolbar class="approvalDecisionBar">
                        <Button text="{i18n>forward}" icon="sap-icon://forward" visible="{view>/selectedTask/canForward}" enabled="{= !${view>/actionBusy} }" press=".onForwardSelected" />
                        <ToolbarSpacer />
                        <Button text="{view>/selectedTask/secondaryActionText}" icon="{view>/selectedTask/secondaryActionIcon}" type="Reject" visible="{view>/selectedTask/canReject}" enabled="{= !${view>/actionBusy} }" press=".onRejectSelected" />
                        <Button text="{i18n>approve}" icon="sap-icon://accept" type="Emphasized" visible="{view>/selectedTask/canApprove}" enabled="{= !${view>/actionBusy} }" press=".onApproveSelected" />
                      </OverflowToolbar>
                    </subHeader>
                    <content>
                      <VBox width="100%" class="approvalInlineDetailContent">
                        <HBox alignItems="Start" justifyContent="SpaceBetween" wrap="Wrap" class="approvalDetailHeader approvalInlineHeader">
                          <HBox alignItems="Center" class="approvalDetailIdentity">
                            <Avatar initials="{view>/selectedTask/employeeInitials}" displaySize="M" displayShape="Circle" backgroundColor="Accent6" class="sapUiSmallMarginEnd" />
                            <VBox>
                              <Title text="{view>/selectedTask/requestTitle}" level="H2" wrapping="true" />
                              <Text text="{view>/selectedTask/employeeName}" class="approvalStrongText" />
                              <Text text="{view>/selectedTask/employeePosition}" visible="{= !!${view>/selectedTask/employeePosition} }" class="approvalSecondaryText" />
                            </VBox>
                          </HBox>
                          <VBox alignItems="End" class="approvalDetailStatuses">
                            <ObjectStatus text="{view>/selectedTask/statusText}" state="{view>/selectedTask/statusState}" icon="{view>/selectedTask/statusIcon}" />
                            <ObjectStatus text="{view>/selectedTask/roleText}" state="{view>/selectedTask/roleState}" visible="{= !!${view>/selectedTask/roleText} }" class="sapUiTinyMarginTop" />
                          </VBox>
                        </HBox>

                        <MessageStrip text="{i18n>backupContextMessage}" type="Information" showIcon="true" visible="{view>/selectedTask/isBackup}" />

                        <HBox wrap="Wrap" class="approvalDetailSummary">
                          <VBox class="approvalDetailSummaryItem"><Label text="{i18n>summary}" /><Text text="{view>/selectedTask/requestSummary}" wrapping="true" /></VBox>
                          <VBox class="approvalDetailSummaryItem"><Label text="{i18n>process}" /><ObjectIdentifier title="{view>/selectedTask/processCode}" text="{view>/selectedTask/businessObjectText}" /></VBox>
                          <VBox class="approvalDetailSummaryItem"><Label text="{i18n>received}" /><Text text="{view>/selectedTask/submittedText}" /></VBox>
                          <VBox class="approvalDetailSummaryItem"><Label text="{i18n>priority}" /><ObjectStatus text="{view>/selectedTask/priorityText}" state="{view>/selectedTask/priorityState}" icon="{view>/selectedTask/priorityIcon}" /></VBox>
                        </HBox>

                        <Panel headerText="{i18n>requestInformation}" class="approvalInlinePanel">
                          <List items="{view>/selectedTask/facts}" showSeparators="Inner" noDataText="{i18n>noRequestInformation}" class="approvalFactsList">
                            <CustomListItem>
                              <HBox width="100%" alignItems="Start" wrap="Wrap" class="approvalFactRow">
                                <VBox class="approvalFactLabelBox"><Text text="{view>section}" class="approvalFactSection" /><Label text="{view>label}" wrapping="true" /></VBox>
                                <VBox class="approvalFactValueBox"><Link text="{view>value}" press=".onDownloadAttachment" wrapping="true" visible="{view>isLink}" /><ObjectStatus text="{view>value}" state="{view>state}" visible="{view>isStatus}" /><Text text="{view>value}" visible="{= !${view>isLink} &amp;&amp; !${view>isStatus} }" /></VBox>
                              </HBox>
                            </CustomListItem>
                          </List>
                        </Panel>

                        <Panel headerText="{i18n>history}" class="approvalInlinePanel">
                          <List items="{view>/selectedTask/events}" showSeparators="Inner" noDataText="{i18n>noHistoryEvents}" class="approvalEventsList">
                            <CustomListItem>
                              <HBox width="100%" alignItems="Start" class="approvalEventRow">
                                <core:Icon src="{view>icon}" decorative="true" class="approvalEventIcon" />
                                <VBox class="approvalEventContent"><HBox width="100%" justifyContent="SpaceBetween" wrap="Wrap"><Text text="{view>type}" class="approvalStrongText" /><Text text="{view>dateText}" class="approvalSecondaryText" /></HBox><Text text="{view>actor}" class="approvalSecondaryText" /><Text text="{view>detail}" wrapping="true" visible="{= !!${view>detail} }" class="sapUiTinyMarginTop" /></VBox>
                              </HBox>
                            </CustomListItem>
                          </List>
                        </Panel>
                      </VBox>
                    </content>
                  </Page>
                </detailPages>
              </SplitApp>
            </VBox>
          </content>
        </IconTabBar>

        <Panel
          id="delegationsPanel"
          expandable="true"
          expanded="true"
          class="approvalDelegationPanel sapUiMediumMarginTop">
          <headerToolbar>
            <OverflowToolbar id="delegationsToolbar">
              <Title id="delegationsTitle" text="{i18n>myDelegations}" level="H2" />
              <ObjectStatus id="delegationsCount" text="{view>/delegationCountLabel}" state="Information" />
              <ToolbarSpacer id="delegationsSpacer" />
              <Button
                id="newDelegationButton"
                text="{i18n>newDelegation}"
                icon="sap-icon://add-employee"
                type="Emphasized"
                enabled="{= !${view>/actionBusy} }"
                press=".onOpenDelegation" />
            </OverflowToolbar>
          </headerToolbar>
          <content>
            <List
              id="delegationsList"
              items="{view>/delegations}"
              showSeparators="Inner"
              noDataText="{i18n>noDelegations}">
              <items>
                <CustomListItem id="delegationItem">
                  <HBox id="delegationRow" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="approvalDelegationRow">
                    <HBox id="delegationIdentity" alignItems="Center" class="approvalDelegationIdentity">
                      <Avatar
                        id="delegateAvatar"
                        initials="{view>delegateInitials}"
                        displaySize="S"
                        displayShape="Circle"
                        backgroundColor="Accent7"
                        class="sapUiSmallMarginEnd" />
                      <VBox id="delegateText">
                        <Text id="delegateName" text="{view>delegateName}" class="approvalStrongText" />
                        <Text id="delegateEmail" text="{view>delegateEmail}" class="approvalSecondaryText" />
                      </VBox>
                    </HBox>
                    <VBox id="delegationMetadata" class="approvalDelegationMetadata">
                      <ObjectStatus id="delegationType" text="{view>typeText}" state="{view>typeState}" icon="{view>typeIcon}" />
                      <Text id="delegationPeriod" text="{view>periodText}" class="approvalSecondaryText" />
                    </VBox>
                    <ObjectStatus id="delegationStatus" text="{view>statusText}" state="{view>statusState}" />
                    <Button
                      id="revokeDelegationButton"
                      text="{i18n>revoke}"
                      icon="sap-icon://decline"
                      type="Transparent"
                      enabled="{view>canRevoke}"
                      visible="{view>canRevoke}"
                      press=".onRevokeDelegation" />
                  </HBox>
                </CustomListItem>
              </items>
            </List>
          </content>
        </Panel>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
