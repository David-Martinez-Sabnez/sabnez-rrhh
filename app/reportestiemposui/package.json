{
  "name": "reportestiemposui",
  "version": "0.0.1",
  "private": true,
  "description": "Reportes de tiempos de Sabnez Consulting",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5",
    "fiori"
  ],
  "scripts": {
    "start": "fiori run --open 'index.html'",
    "build": "ui5 build --config ui5.yaml --clean-dest --dest dist",
    "start-local": "fiori run --config ./ui5-local.yaml --open 'index.html'"
  },
  "devDependencies": {
    "@sap/ux-ui5-tooling": "^1.20.0",
    "@ui5/cli": "^4.0.0",
    "ui5-task-zipper": "^3.3.1"
  },
  "ui5": {
    "dependencies": [
      "ui5-task-zipper"
    ]
  }
}