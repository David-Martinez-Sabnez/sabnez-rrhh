{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sabnez.com.configuracionui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/configuracion/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Configuracion-manage": {
          "semanticObject": "Configuracion",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://settings",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sabnez.com.configuracionui.i18n.i18n"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "ParametrosList", "target": "ParametrosList" },
        { "pattern": "Parametros({key}):?query:", "name": "ParametroDetalle", "target": "ParametroDetalle" }
      ],
      "targets": {
        "ParametrosList": {
          "type": "Component",
          "id": "ParametrosList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Parametros",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Parametros": { "detail": { "route": "ParametroDetalle" } }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable", "personalization": true }
                }
              }
            }
          }
        },
        "ParametroDetalle": {
          "type": "Component",
          "id": "ParametroDetalle",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/Parametros" } }
        }
      }
    }
  },
  "sap.cloud": { "public": true, "service": "sabnezrrhh.service" }
}
