<mvc:View controllerName="sabnez.com.tiemposaprobacionui.controller.App" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <SplitApp id="approvalSplit" initialMaster="masterPage" initialDetail="emptyPage" mode="ShowHideMode">
    <masterPages>
      <Page id="masterPage" title="Aprobación de tiempos" busy="{view>/busy}">
        <headerContent><Button icon="sap-icon://refresh" tooltip="Actualizar" press=".onRefresh"/></headerContent>
        <subHeader><OverflowToolbar><SearchField width="100%" placeholder="Empleado, cliente o proyecto" liveChange=".onSearch"/><Select selectedKey="{view>/statusFilter}" change=".onStatusChange"><core:Item key="PENDING" text="Pendientes"/><core:Item key="SUBMITTED" text="Enviadas"/><core:Item key="LEADER_APPROVED" text="Aprobadas por líder"/><core:Item key="INTERNALLY_APPROVED" text="Aprobadas"/><core:Item key="RETURNED" text="Devueltas"/></Select></OverflowToolbar></subHeader>
        <content><MessageStrip text="{view>/error}" type="Error" showIcon="true" visible="{= !!${view>/error} }"/><List id="inboxList" items="{view>/filteredSheets}" noDataText="No hay hojas para este filtro" growing="true" itemPress=".onOpenSheet"><ObjectListItem type="Active" title="{view>empleadoNombre}" number="{view>totalHoras}" numberUnit="h" intro="{= ${view>clienteNombre} + ' · ' + ${view>proyectoNombre} }"><attributes><ObjectAttribute text="{= ${view>semanaInicio} + ' — ' + ${view>semanaFin} }"/><ObjectAttribute text="{view>siguienteAccion}"/></attributes><firstStatus><ObjectStatus text="{view>statusLabel}" state="{view>statusState}"/></firstStatus><secondStatus><ObjectStatus text="{= ${view>registrosConAlerta} + ' alerta(s)' }" state="Warning" visible="{= ${view>registrosConAlerta} > 0 }"/></secondStatus></ObjectListItem></List></content>
      </Page>
    </masterPages>
    <detailPages>
      <Page id="emptyPage" title="Detalle"><content><IllustratedMessage illustrationType="sapIllus-NoData" title="Selecciona una hoja semanal" description="Aquí podrás revisar su composición, soportes y alertas."/></content></Page>
      <Page id="detailPage" title="Revisión semanal" showNavButton="true" navButtonPress=".onBack" busy="{view>/detailBusy}">
        <headerContent><Button text="Reporte CSV" icon="sap-icon://download" press=".onDownloadReport" enabled="{= !!${view>/detail/resumen/ID} }"/></headerContent>
        <content>
          <VBox class="detailContent">
            <ObjectHeader title="{view>/detail/resumen/empleadoNombre}" intro="{= ${view>/detail/resumen/clienteNombre} + ' · ' + ${view>/detail/resumen/proyectoNombre} }" number="{view>/detail/resumen/totalHoras}" numberUnit="horas"><statuses><ObjectStatus text="{view>/detail/resumen/statusLabel}" state="{view>/detail/resumen/statusState}"/></statuses><attributes><ObjectAttribute title="Semana" text="{= ${view>/detail/resumen/semanaInicio} + ' — ' + ${view>/detail/resumen/semanaFin} }"/><ObjectAttribute title="Siguiente paso" text="{view>/detail/resumen/siguienteAccion}"/><ObjectAttribute title="Registros" text="{view>/detail/resumen/totalRegistros}"/></attributes></ObjectHeader>
            <HBox class="summaryCards" wrap="Wrap"><VBox class="summaryCard"><Text text="Total"/><ObjectNumber number="{view>/detail/resumen/totalHoras}" unit="h"/></VBox><VBox class="summaryCard"><Text text="Alertas"/><ObjectNumber number="{view>/detail/resumen/registrosConAlerta}" state="Warning"/></VBox><VBox class="summaryCard"><Text text="Soportes pendientes"/><ObjectNumber number="{view>/detail/resumen/soportesPendientes}" state="{= ${view>/detail/resumen/soportesPendientes} > 0 ? 'Error' : 'Success' }"/></VBox></HBox>
            <Panel headerText="Composición de la semana" class="reviewPanel"><Table items="{view>/detail/registros}" noDataText="No hay registros"><columns><Column><Text text="Fecha"/></Column><Column hAlign="End"><Text text="Horas"/></Column><Column><Text text="Tipo"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Actividad"/></Column><Column hAlign="End"><Text text="Soporte"/></Column></columns><items><ColumnListItem><cells><ObjectIdentifier title="{view>fecha}"/><ObjectNumber number="{view>horas}" unit="h" state="{= ${view>alerta} ? 'Warning' : 'None' }"/><ObjectStatus text="{view>typeLabel}" state="{= ${view>tipo} === 'REGULAR' ? 'None' : 'Warning' }"/><Text text="{view>descripcion}" maxLines="3"/><Button text="{view>soporteNombre}" icon="sap-icon://attachment" type="Transparent" press=".onDownloadEvidence" visible="{= !!${view>soporteID} }"/></cells></ColumnListItem></items></Table></Panel>
            <Panel headerText="Decisión" class="reviewPanel"><VBox class="sapUiSmallMargin"><Label text="Comentario para el empleado"/><TextArea value="{view>/comment}" rows="3" placeholder="Obligatorio al devolver; opcional al aprobar"/><Toolbar design="Transparent"><Button text="Devolver para corregir" icon="sap-icon://undo" type="Reject" press=".onReturn" enabled="{view>/detail/resumen/puedeDevolver}"/><ToolbarSpacer/><Button text="Aprobar" icon="sap-icon://accept" type="Accept" press=".onApprove" enabled="{view>/detail/resumen/puedeAprobar}"/></Toolbar></VBox></Panel>
          </VBox>
        </content>
      </Page>
    </detailPages>
  </SplitApp>
</mvc:View>
