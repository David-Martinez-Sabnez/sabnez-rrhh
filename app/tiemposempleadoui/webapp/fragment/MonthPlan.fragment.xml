<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog title="Repetir planificación mensual" contentWidth="36rem" stretchOnPhone="false" class="copyEntryDialog">
    <content><VBox class="sapUiMediumMargin">
      <Label text="Mes de origen" required="true"/><DatePicker value="{view>/monthPlan/sourceMonth}" valueFormat="yyyy-MM-dd" displayFormat="MMMM yyyy"/>
      <Label text="Mes de destino" required="true" class="sapUiSmallMarginTop"/><DatePicker value="{view>/monthPlan/targetMonth}" valueFormat="yyyy-MM-dd" displayFormat="MMMM yyyy"/>
      <Label text="Calendario de destino" class="sapUiSmallMarginTop"/>
      <RadioButtonGroup id="monthPlanMode" selectedIndex="0" columns="1"><buttons><RadioButton text="Solo días hábiles de Colombia"/><RadioButton text="Lunes a viernes, incluidos festivos"/><RadioButton text="Todos los días calendario"/></buttons></RadioButtonGroup>
      <MessageStrip text="Se copian únicamente registros regulares conservando su posición semanal. Los soportes y registros equivalentes no se copian." type="Information" showIcon="true" class="sapUiSmallMarginTop"/>
    </VBox></content>
    <beginButton><Button text="Repetir en otro mes" type="Emphasized" icon="sap-icon://duplicate" press=".onConfirmMonthPlan"/></beginButton><endButton><Button text="Cancelar" press=".onCancelMonthPlan"/></endButton>
  </Dialog>
</core:FragmentDefinition>
