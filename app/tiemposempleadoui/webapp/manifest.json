{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sabnez.com.tiemposempleadoui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": { "mainService": { "uri": "/tiempos-empleado/", "type": "OData", "settings": { "odataVersion": "4.0" } } },
    "crossNavigation": { "inbounds": { "MisTiempos-display": { "semanticObject": "MisTiempos", "action": "display", "title": "{{appTitle}}", "icon": "sap-icon://timesheet", "signature": { "parameters": {}, "additionalParameters": "allowed" } } } }
  },
  "sap.ui": { "technology": "UI5", "deviceTypes": { "desktop": true, "tablet": true, "phone": true } },
  "sap.ui5": {
    "dependencies": { "minUI5Version": "1.120.0", "libs": { "sap.f": {}, "sap.m": {}, "sap.ui.core": {}, "sap.ui.layout": {}, "sap.ui.unified": {} } },
    "models": { "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "sabnez.com.tiemposempleadoui.i18n.i18n" } } },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "rootView": { "viewName": "sabnez.com.tiemposempleadoui.view.Main", "type": "XML", "id": "Main", "async": true }
  },
  "sap.cloud": { "public": true, "service": "sabnezrrhh.service" }
}
