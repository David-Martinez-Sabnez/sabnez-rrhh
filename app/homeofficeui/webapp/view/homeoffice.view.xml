<mvc:View
    id="homeOfficeView"
    controllerName="sabnez.com.homeofficeui.controller.homeoffice"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    displayBlock="true">

    <f:DynamicPage
        id="homeOfficePage"
        class="homeOfficeDynamicPage"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
        fitContent="true"
        preserveHeaderStateOnScroll="true"
        toggleHeaderOnTitleClick="true">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="{i18n>appTitle}" level="H1" /></f:heading>
                <f:expandedContent><Text text="Selecciona y confirma tus días de trabajo remoto" /></f:expandedContent>
                <f:snappedContent><Text text="{view>/weekLabel}" /></f:snappedContent>
                <f:actions>
                    <Button id="refreshButton" icon="sap-icon://refresh" tooltip="Actualizar disponibilidad" enabled="{= !${view>/busy} }" press=".onRefreshButtonPress" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <VBox width="100%" class="homeOfficeHeaderContent">
                        <VBox id="weekHeaderBox" class="homeOfficeHeader">
                            <Title id="weekTitle" text="{view>/weekLabel}" level="H2" />
                            <Text id="deadlineText" text="{view>/deadlineLabel}" wrapping="true" class="homeOfficeDeadline" />
                        </VBox>
                        <HBox id="summaryBox" wrap="Wrap" alignItems="Center" class="homeOfficeSummary">
                            <VBox id="selectionSummaryBox" class="summaryBlock">
                                <Label id="selectionSummaryLabel" text="Tu selección" />
                                <ObjectNumber id="selectionSummaryNumber" number="{view>/selectedCount}" unit="{= 'de ' + ${view>/maxDays} + ' días' }" />
                            </VBox>
                            <VBox id="windowSummaryBox" class="summaryBlock">
                                <Label id="windowSummaryLabel" text="Estado de la ventana" />
                                <ObjectStatus id="windowStatus" text="{= ${view>/windowOpen} ? 'Abierta' : 'Cerrada' }" state="{= ${view>/windowOpen} ? 'Success' : 'Error' }" icon="{= ${view>/windowOpen} ? 'sap-icon://unlocked' : 'sap-icon://locked' }" />
                            </VBox>
                        </HBox>
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                id="mainContentBox"
                class="sapUiResponsiveContentPadding homeOfficeContent">

                <MessageStrip
                    id="errorMessageStrip"
                    text="{view>/error}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{= !!${view>/error} }"
                    class="sapUiSmallMarginBottom" />

                <Title
                    id="daysTitle"
                    text="Selecciona tus días"
                    level="H3"
                    class="sapUiSmallMarginBottom" />

                <Text
                    id="rulesText"
                    text="Cada día tiene un máximo de cinco cupos. Solo puedes seleccionar dos días por semana."
                    wrapping="true"
                    class="sapUiSmallMarginBottom" />

                <FlexBox
                    id="daysFlexBox"
                    items="{view>/days}"
                    wrap="Wrap"
                    alignItems="Stretch"
                    class="daysContainer">

                    <items>
                        <VBox
                            id="dayCardBox"
                            class="dayCard sapUiSmallMarginEnd sapUiSmallMarginBottom">

                            <Title
                                id="dayTitle"
                                text="{view>nombreDia}"
                                level="H3" />

                            <Text
                                id="dayDateText"
                                text="{view>dateLabel}"
                                class="dayDate" />

                            <ObjectStatus
                                id="dayStatus"
                                text="{view>statusText}"
                                state="{view>statusState}"
                                icon="{view>statusIcon}"
                                class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

                            <ObjectStatus
                                id="reservationCountdownStatus"
                                text="{= 'Tiempo restante: ' + ${view>reservationRemainingText} }"
                                state="{view>reservationCountdownState}"
                                icon="sap-icon://history"
                                visible="{view>reservationCountdownVisible}"
                                class="reservationCountdown sapUiTinyMarginBottom" />

                            <ProgressIndicator
                                id="capacityProgress"
                                percentValue="{view>occupationPercent}"
                                displayValue="{= ${view>cuposDisponibles} + ' de ' + ${view>cuposTotales} + ' cupos disponibles' }"
                                state="{= ${view>cupoCompleto} ? 'Error' : 'Success' }"
                                showValue="true"
                                width="100%" />

                            <Text
                                id="dayReasonText"
                                text="{view>motivoNoDisponible}"
                                visible="{= !!${view>motivoNoDisponible} }"
                                wrapping="true"
                                class="dayReason sapUiSmallMarginTop" />

                            <Button
                                id="dayActionButton"
                                text="{view>actionText}"
                                type="{view>actionType}"
                                icon="{view>actionIcon}"
                                enabled="{= ${view>habilitado} &amp;&amp; !${view>/busy} }"
                                visible="{view>actionVisible}"
                                busy="{view>actionBusy}"
                                busyIndicatorDelay="0"
                                press=".onDayActionButtonPress"
                                width="100%"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </items>
                </FlexBox>

                <MessageStrip
                    id="reservationMessageStrip"
                    text="{view>/reservationBannerText}"
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{view>/hasPendingReservations}"
                    class="sapUiMediumMarginTop" />

                <HBox
                    id="confirmActionsBox"
                    justifyContent="End"
                    visible="{view>/hasPendingReservations}"
                    class="sapUiMediumMarginTop">

                    <Button
                        id="confirmSelectionButton"
                        text="{= ${view>/reservedCount} === 1 ? 'Confirmar día' : 'Confirmar días' }"
                        icon="sap-icon://accept"
                        type="Emphasized"
                        enabled="{= ${view>/windowOpen} &amp;&amp; !${view>/busy} }"
                        press=".onConfirmSelectionButtonPress" />
                </HBox>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
